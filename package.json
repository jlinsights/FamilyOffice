{
  "name": "familyoffice-s",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' next dev --turbo",
    "dev:mobile": "NODE_OPTIONS='--no-deprecation' next dev --turbo -H 0.0.0.0",
    "dev:inspect": "NODE_OPTIONS='--inspect --no-deprecation' next dev --turbo",
    "dev:clean": "rm -rf .next && npm run dev",
    "build": "NODE_OPTIONS='--no-deprecation' next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:security": "jest --testPathPattern=tests/security",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:performance": "node tests/performance/load-tests.js",
    "test:performance:standard": "artillery run artillery.yml",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:security && npm run test:e2e && npm run test:performance",
    "test:coverage:report": "jest --coverage && open coverage/lcov-report/index.html",
    "test:cron": "node scripts/test-cron.js",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "analyze": "cross-env ANALYZE=true next build",
    "vercel-build": "next build",
    "lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "performance:check": "npm run build && npm run lighthouse",
    "bundle:size": "npm run build && npx @next/bundle-analyzer",
    "optimize:images": "next build && npx imagemin public/images --out-dir=public/images/optimized",
    "cache:clear": "rm -rf .next && rm -rf node_modules/.cache",
    "agent:check": "npm run lint && npm run typecheck",
    "agent:test": "npm run agent:check && npm run test:e2e",
    "performance:monitor": "npm run dev & sleep 10 && npm run lighthouse && pkill -f 'next dev'",
    "secrets:setup": "tsx scripts/setup-secret-manager.ts",
    "secrets:sync": "tsx scripts/setup-secret-manager.ts",
    "secrets:validate": "tsx scripts/validate-secrets.ts",
    "secrets:migrate": "./scripts/migrate-secrets.sh",
    "dev:1p": "npm run secrets:sync && npm run dev",
    "build:1p": "npm run secrets:sync && npm run build",
    "1password:login": "op signin",
    "1password:setup": "./scripts/setup-1password.sh"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@clerk/nextjs": "^6.20.0",
    "@hookform/resolvers": "3.9.1",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@react-email/components": "^0.5.7",
    "@sentry/nextjs": "^10.22.0",
    "@sentry/profiling-node": "^10.22.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.5",
    "@types/qrcode": "^1.5.5",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "10.4.20",
    "axios": "^1.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "3.6.0",
    "embla-carousel-react": "8.5.1",
    "framer-motion": "^12.23.24",
    "googleapis": "^131.0.0",
    "input-otp": "1.4.1",
    "ioredis": "^5.6.1",
    "logs-so": "^2.2.2",
    "lucide-react": "^0.525.0",
    "mini-svg-data-uri": "^1.4.4",
    "nanoid": "^5.1.5",
    "next": "^15.2.3",
    "next-themes": "0.2.0",
    "node-cache": "^5.1.2",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.3.1",
    "react-email": "^4.3.2",
    "react-hook-form": "7.54.1",
    "recharts": "^2.15.0",
    "redis": "^5.6.0",
    "resend": "^6.2.2",
    "rss-parser": "^3.13.0",
    "sonner": "1.7.1",
    "svix": "^1.67.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "1.0.7",
    "web-vitals": "^5.1.0",
    "zod": "3.24.1"
  },
  "overrides": {
    "playwright": "^1.56.1",
    "@playwright/test": "^1.56.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@next/bundle-analyzer": "^15.4.3",
    "@playwright/test": "^1.56.1",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/babel__generator": "^7.27.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.9",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "artillery": "^2.0.26",
    "critters": "^0.0.23",
    "cross-env": "^7.0.3",
    "eslint": "9.31.0",
    "eslint-config-next": "15.3.5",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "openapi-types": "^12.1.3",
    "playwright": "^1.56.1",
    "postcss": "^8.4.38",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.17",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}
