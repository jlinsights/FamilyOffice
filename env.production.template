# FamilyOffice 프로덕션 환경 변수 템플릿
# 이 파일을 복사하여 실제 값으로 채워넣으세요

# =============================================================================
# 필수 환경 변수 (반드시 설정해야 함)
# =============================================================================

# Clerk 인증
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Supabase 데이터베이스
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 앱 URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# =============================================================================
# AI 서비스 API 키 (선택적)
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic Claude
CLAUDE_API_KEY=sk-ant-your_claude_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Google AI
GEMINI_API_KEY=AIza-your_gemini_api_key_here
GOOGLE_AI_API_KEY=AIza-your_google_ai_api_key_here

# =============================================================================
# 외부 서비스 통합 (선택적)
# =============================================================================

# Beehiiv 뉴스레터
BEEHIIV_API_KEY=your_beehiiv_api_key_here
BEEHIIV_PUBLICATION_ID=your_publication_id_here
BEEHIIV_WEBHOOK_SECRET=your_webhook_secret_here

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# =============================================================================
# 모니터링 및 분석 (선택적)
# =============================================================================

# Sentry 에러 추적
SENTRY_DSN=https://your_sentry_dsn_here

# DataDog 모니터링
DATADOG_API_KEY=your_datadog_api_key_here

# =============================================================================
# 성능 최적화 (선택적)
# =============================================================================

# CDN 설정
CDN_BASE_URL=https://your-cdn-domain.com

# Cloudflare 설정
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here

# =============================================================================
# 개발 도구 (자동 설정됨)
# =============================================================================

# Node.js 환경
NODE_ENV=production

# 번들 분석 (개발용)
ANALYZE=false

# =============================================================================
# 보안 설정 (선택적)
# =============================================================================

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# CORS 설정
CORS_ORIGIN=https://your-domain.vercel.app

# =============================================================================
# 한국 시장 특화 설정 (선택적)
# =============================================================================

# 시간대 설정
TZ=Asia/Seoul

# 한국어 설정
NEXT_PUBLIC_LOCALE=ko-KR

# =============================================================================
# 사용법
# =============================================================================

# 1. 이 파일을 .env.production으로 복사
# cp env.production.template .env.production

# 2. 실제 값으로 교체
# 3. Vercel 대시보드에서 환경 변수 설정
# 4. 또는 Vercel CLI로 설정:
# vercel env add NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY

# 주의사항:
# - NEXT_PUBLIC_ 접두사가 붙은 변수는 클라이언트에서 접근 가능
# - 민감한 정보는 서버에서만 사용
# - 프로덕션에서는 실제 API 키 사용
# - 테스트 키는 개발 환경에서만 사용 