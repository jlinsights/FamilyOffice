# =============================================================================
# Family Office Backend Environment Variables
# =============================================================================

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=development
PORT=3001
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=familyoffice
DB_USER=postgres
DB_PASSWORD=password
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=familyoffice-api
JWT_AUDIENCE=familyoffice-client

# =============================================================================
# Security Settings
# =============================================================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=your-session-secret-key
COOKIE_SECRET=your-cookie-secret-key

# =============================================================================
# External API Keys
# =============================================================================
# Market Data Providers
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
YAHOO_FINANCE_API_KEY=your-yahoo-finance-key
BLOOMBERG_API_KEY=your-bloomberg-key

# Custody Banks
CUSTODY_BANK_1_API_KEY=your-custody-bank-1-key
CUSTODY_BANK_2_API_KEY=your-custody-bank-2-key

# Accounting Systems
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret

# =============================================================================
# Monitoring & Logging
# =============================================================================
LOG_LEVEL=info
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
SENTRY_DSN=your-sentry-dsn

# =============================================================================
# Email Configuration
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@familyoffice.com

# =============================================================================
# File Storage
# =============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=familyoffice-documents

# =============================================================================
# Third Party Services
# =============================================================================
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# Development Settings
# =============================================================================
DEBUG=true
ENABLE_SWAGGER=true
ENABLE_GRAPHIQL=true
MOCK_EXTERNAL_APIS=false

# =============================================================================
# Production Settings
# =============================================================================
# Enable SSL/TLS
FORCE_HTTPS=false
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# Database SSL
DB_SSL_ENABLED=false
DB_SSL_CA_PATH=/path/to/ca-certificate.crt

# Redis SSL
REDIS_SSL_ENABLED=false
REDIS_SSL_CA_PATH=/path/to/redis-ca-certificate.crt

# =============================================================================
# Kubernetes Settings
# =============================================================================
K8S_NAMESPACE=familyoffice
K8S_SERVICE_ACCOUNT=familyoffice-service-account
K8S_IMAGE_PULL_SECRET=familyoffice-registry-secret

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_REAL_TIME_UPDATES=true
ENABLE_AUDIT_TRAIL=true
ENABLE_COMPLIANCE_REPORTING=true
ENABLE_MULTI_TENANCY=true
ENABLE_SSO=false
ENABLE_MFA=true

# =============================================================================
# Performance Settings
# =============================================================================
CACHE_TTL=3600
QUERY_TIMEOUT=30000
MAX_FILE_SIZE=10485760
COMPRESSION_LEVEL=6

# =============================================================================
# Backup & Recovery
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=familyoffice-backups

# =============================================================================
# Compliance & Audit
# =============================================================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_LEVEL=info
COMPLIANCE_REPORTING_ENABLED=true
GDPR_COMPLIANCE_ENABLED=true
SOX_COMPLIANCE_ENABLED=true

# =============================================================================
# Testing
# =============================================================================
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=familyoffice_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=password
TEST_REDIS_URL=redis://localhost:6380 