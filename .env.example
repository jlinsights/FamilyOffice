# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# v0.dev AI Integration (Optional)
V0_API_KEY=your_v0_api_key_here

# Financial APIs (Optional - if implementing financial features)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
YAHOO_FINANCE_API_KEY=your_yahoo_finance_key_here

# Redis Cache (Optional - if implementing caching)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# OpenAI (Optional - if implementing AI features)
OPENAI_API_KEY=sk-your_openai_key_here

# Production URLs
NEXT_PUBLIC_APP_URL=https://yourapp.com
NEXT_PUBLIC_VERCEL_URL=https://yourapp.vercel.app