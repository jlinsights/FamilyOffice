# Core Authentication & Database (Required)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App Configuration (Required)
NEXT_PUBLIC_APP_URL=https://yourapp.com

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-DB6TXRZLTK
LOGS_SO_API_KEY=ls_live_your_api_key_here
LOGS_SO_WORKSPACE_ID=your_workspace_id_here

# Cal.com Integration (Optional)
NEXT_PUBLIC_CALCOM_API_KEY=cal_live_your_calcom_key_here

# Financial APIs (Optional)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
YAHOO_FINANCE_API_KEY=your_yahoo_finance_key_here

# Redis Cache (Optional - Recommended for Production)
# Local development
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Production examples:
# REDIS_URL=redis://user:password@redis.example.com:6380
# REDIS_URL=rediss://default:password@redis.example.com:6380  # SSL
# For Upstash: REDIS_URL=rediss://default:token@region.upstash.io:6380

# Newsletter Integration (Optional)
BEEHIIV_API_KEY=your_beehiiv_api_key_here
BEEHIIV_PUBLICATION_ID=pub_your_publication_id_here

# Blog Integration (Optional)
NAVER_BLOG_ID=lim_jaehong

# Kakao Business Integration (Optional)
KAKAO_APP_KEY=your_kakao_app_key_here
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
KAKAO_ADMIN_KEY=your_kakao_admin_key_here
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key_here
NEXT_PUBLIC_KAKAO_CHANNEL_ID=your_kakao_channel_id_here
NEXT_PUBLIC_KAKAO_PIXEL_ID=8992336493423513326

# Development Flags (Optional)
SKIP_ENV_VALIDATION=false
SKIP_RATE_LIMIT=true

# SEO Feature Flags (Production Override - Optional)
# By default, SEO features are disabled in production for safety
# Enable gradually after monitoring and testing
FEATURE_ADVANCED_SEO=false
FEATURE_AI_KEYWORDS=false  
FEATURE_SEO_DASHBOARD=false
FEATURE_CONTENT_OPT=false
FEATURE_CROSS_DOMAIN=false
FEATURE_STRUCTURED_DATA=true  # Safe to enable - basic structured data

# SEO Verification Tokens (Optional - Move from hardcoded values)
NEXT_PUBLIC_NAVER_VERIFICATION=your_naver_verification_code
NEXT_PUBLIC_BING_VERIFICATION=your_bing_verification_code

# Monitoring and Error Tracking (Recommended for Production)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-client-dsn@sentry.io/project-id
SENTRY_DSN=https://your-sentry-server-dsn@sentry.io/project-id
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=your-sentry-project

# Vercel Analytics (Automatically provided by Vercel)
VERCEL_ANALYTICS_ID=your-vercel-analytics-id